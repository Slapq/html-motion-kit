{
  "name": "kinema",
  "version": "0.5.0",
  "description": "Agent-native video creator: frame-exact HTML/JS motion graphics rendered to MP4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./engine": "./engine/index.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "video",
    "motion-graphics",
    "agent",
    "animation",
    "mp4",
    "dsh",
    "dsh-plugin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dsh",
    "engine",
    "docs/lessons.md",
    "docs/reference.md",
    "tools",
    "projects/demo",
    "projects/graph-showcase",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "scripts": {
    "serve": "node tools/serve.mjs",
    "img": "node tools/gen-image.mjs",
    "render": "node tools/render.mjs",
    "audit": "node tools/audit.mjs",
    "pacing": "node tools/pacing.mjs",
    "new": "node tools/new-project.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "puppeteer-core": "25.12.0"
  }
}
